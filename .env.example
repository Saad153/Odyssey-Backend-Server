# Copy this file to .env and fill in real values. .env is gitignored — never commit real secrets.

# --- Invoice emailing (functions/mailer.js, functions/pdf.js) ---
# SMTP account used to relay mail. The email's "From" header is set to the
# sending employee's own address, but authentication always happens as this account.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Where the backend can reach the frontend, for Puppeteer to render the invoice PDF.
# Dev: http://localhost:3000   Prod: http://localhost:3003 (or your deployed URL)
FRONTEND_BASE_URL=http://localhost:3003

# Optional: separate secret for the short-lived invoice-print token. Falls back
# to JWT_SECRET if unset.
PRINT_TOKEN_SECRET=

# REQUIRED. Used to sign/verify login tokens (functions/tokenVerification.js).
# There is no built-in fallback: the server refuses to start if this is unset
# (except under NODE_ENV=test). Generate a UNIQUE value PER INSTALL - reusing
# one across customers would let a token from one install validate on another:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- Licensing / kill-switch (functions/license/) ---
# Unique id for THIS install; must match what you manage on the licence server.
INSTALL_ID=
# Your cloud licence server base URL.
LICENSE_SERVER_URL=https://license.seanetpk.com
# Owner / self-hosted exemption. Set to true ONLY on the install owned by the
# company that built the software - licensing becomes a no-op (always active, no
# heartbeat, never read-only) so they can never lock themselves out. Leave unset
# (or false) for every leased client install.
LICENSE_EXEMPT=false

# --- First-load admin seeding (functions/seedAdmin.js) ---
# On first boot with an empty Employees table, a default admin is created so the
# system is usable immediately. Defaults to admin / abc.123 if unset. Override
# per install and change the password after first login.
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_PASSWORD=abc.123
