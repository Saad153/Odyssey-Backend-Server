# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production - sealed build output only; keep the build script itself
/build/dist

# runtime licence cache (per-install, signed blob + clock mark)
odyssey-license.dat
*.license.dat

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
.env
.env*.local

# DB backups (contain real data, never commit)
/backups

# Correction lists produced by scripts/backfillAwbl.js - real job data, meant
# to be forwarded to operations, not committed
awbl-corrections-*.csv

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
# index.js
# package.json
# models/index.js
